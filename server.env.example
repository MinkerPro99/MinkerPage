GROQ_API_KEY=

# Alexa Echo announcements are handled by server.js via alexa-remote2.
ALEXA_ENABLED=false
ALEXA_DEVICE_NAME=
ALEXA_AMAZON_PAGE=amazon.de
ALEXA_ACCEPT_LANGUAGE=en-GB
ALEXA_COOKIE_REFRESH_INTERVAL_DAYS=1
ALEXA_REFRESH_INTERVAL_HOURS=12
ALEXA_SPEECH_WORDS_PER_SECOND=2.15
ALEXA_SPEECH_MIN_WAIT_MS=2500
ALEXA_SPEECH_MAX_WAIT_MS=30000
ALEXA_SPEECH_PADDING_MS=1800
ALEXA_SPEECH_SETTLE_MS=1500
ALEXA_REFRESH_TOKEN=
ALEXA_COOKIE=

# Shared secret for the PC command bridge.
JARVIS_COMMAND_TOKEN=

# Optional Alexa Custom Skill protection.
# Use ALEXA_SKILL_TOKEN in the endpoint URL query string during development.
# Add ALEXA_SKILL_ID after the skill is created.
ALEXA_SKILL_TOKEN=
ALEXA_SKILL_ID=
