{
  "apps": {
    "opera gx": [
      "%LOCALAPPDATA%\\Programs\\Opera GX\\opera.exe",
      "%LOCALAPPDATA%\\Programs\\Opera GX\\launcher.exe",
      "%USERPROFILE%\\AppData\\Local\\Programs\\Opera GX\\launcher.exe",
      "%USERPROFILE%\\AppData\\Local\\Programs\\Opera GX\\opera.exe",
      "C:\\Program Files\\Opera GX\\opera.exe",
      "C:\\Program Files\\Opera GX\\launcher.exe"
    ],
    "discord": [
      "%LOCALAPPDATA%\\Discord\\Update.exe --processStart Discord.exe"
    ],
    "steam": [
      "C:\\Program Files (x86)\\Steam\\steam.exe"
    ]
  },
  "folders": {
    "downloads": "%USERPROFILE%\\Downloads",
    "documents": "%USERPROFILE%\\Documents",
    "homework": "%USERPROFILE%\\Documents"
  },
  "scripts": {
    "shutdown setup": "%CD%\\shutdown.bat"
  },
  "defaults": {
    "browser": "opera gx",
    "search_engine": "https://www.google.com/search?q={query}"
  },
  "sort_categories": {
    "Images": [".jpg", ".jpeg", ".png", ".gif", ".webp", ".bmp", ".svg"],
    "Documents": [".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx", ".txt", ".md"],
    "Videos": [".mp4", ".mkv", ".mov", ".avi", ".webm"],
    "Audio": [".mp3", ".wav", ".flac", ".m4a", ".ogg"],
    "Archives": [".zip", ".rar", ".7z", ".tar", ".gz"],
    "Installers": [".exe", ".msi", ".dmg", ".iso"],
    "Code": [".py", ".js", ".ts", ".html", ".css", ".json", ".xml", ".yml", ".yaml"],
    "Other": []
  }
}
